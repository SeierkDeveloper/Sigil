# Every setting the Sigil node reads, with what it does. Locally, copy this to
# web/.env.local. On Railway (railway.toml at the repository root), set them as
# service variables. Required in production: SIGIL_ORIGIN, NEXT_PUBLIC_SITE_URL.
#
# On Railway also:
#   RAILWAY_RUN_UID=0      the volume is mounted as root; without it the node cannot write /data
#   PORT                   set by Railway itself; the node listens on it (3000 when unset)
#   Volume                 one volume mounted at /data, region EU West (Amsterdam), one replica
#   Health check           /api/health (in railway.toml)
#   Domain                 add sigil.fun under Networking, then set SIGIL_ORIGIN and
#                          NEXT_PUBLIC_SITE_URL to https://sigil.fun and redeploy (they are build arguments)

# Public address of the site, used in links and connector snippets. Set at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin the server trusts for passkeys and same-origin checks, for example
# https://sigil.fun. Leave empty locally. Required in production: without it the
# origin is taken from the request's Host header (the node warns at start).
SIGIL_ORIGIN=

# Proxies in front of the node that add to X-Forwarded-For (1: Railway's proxy,
# or none). Rate limits count the address the nearest one saw. 0 ignores
# forwarded headers (every visitor then shares one limit).
SIGIL_PROXY_HOPS=1

# Where the SQLite database lives (default: web/.data; /data in the container).
SIGIL_DATA_DIR=

# Hourly local sealing of the read log (on by default).
SIGIL_SEALS=on

# Publishing seals to the SigilSeal contract. OFF until the contract is deployed.
SIGIL_ANCHOR=off
SIGIL_ANCHOR_RPC_URL=
SIGIL_SEAL_CONTRACT=
SIGIL_SEALER_KEY=

# A public, read-only RPC address of the chain the seals are anchored on. With
# anchoring on, the verify page reads roots from SigilSeal in the visitor's
# browser, and this one origin is added to the content security policy.
SIGIL_CHAIN_READ_RPC=

# The length of a day for legacy plans, in milliseconds. Leave unset: only tests shorten it.
SIGIL_LEGACY_DAY_MS=

# Live sync: public OAuth client ids. The sign-in runs in the owner's browser
# with PKCE; no client secret is set here or kept on the server. Unset, the
# sources show how to add one.
SIGIL_GOOGLE_CLIENT_ID=
SIGIL_SLACK_CLIENT_ID=

# The AI self's on-chain identity. Leave empty until SigilSelfRegistry is
# deployed (contracts/script/DeploySigilSelf.s.sol): the Identity tab then
# works off chain (the self key, a signed identity statement, a rules draft).
# Chain id and registry address are public. The read address is a public,
# read-only RPC; the vault reads a self wallet's spends through it in the
# owner's browser, and its origin is added to the content security policy.
SIGIL_IDENTITY_CHAIN_ID=
SIGIL_IDENTITY_REGISTRY=
SIGIL_IDENTITY_READ_RPC=

# Voice: speech to text runs in the visitor's own browser; the server only hands
# out the model's files, fetched once into SIGIL_MODEL_DIR like the sentence model.
SIGIL_VOICE=on
SIGIL_SPEECH_MODEL=Xenova/whisper-tiny.en

# Backups: storage addresses the page may upload to, on top of common S3,
# IPFS pinning and Arweave upload hosts. https, space separated. Read at build time.
SIGIL_BACKUP_ORIGINS=

# Let this node talk to nodes and restore addresses on a private network. Off
# unless the nodes run on one machine or one private network.
SIGIL_NODE_ALLOW_PRIVATE=off
